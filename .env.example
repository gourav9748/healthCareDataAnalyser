# ---------------------------------------------------------------------------
# AI agent configuration
# ---------------------------------------------------------------------------
# The "Run analysis" button calls /api/agent, which resolves in this order:
#   1. External agent proxy (AGENT_ENDPOINT + AGENT_API_KEY), if set.
#   2. Built-in Gemini agent (GEMINI_API_KEY), if set.
#   3. Fallback: returns the prompt it would have sent (no key needed).

# --- Option A: built-in Gemini agent (recommended) -------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-2.5-flash. Other options: gemini-2.5-flash-lite,
# gemini-2.5-pro. Google retires models over time — GET /api/models on your
# deployment to see exactly which models your key can use, then set one here.
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: external agent proxy (optional override) --------------------
# If both are set, this takes precedence over Gemini. Leave unset to use Gemini.
# AGENT_ENDPOINT=https://your-agent.vercel.app/api/run
# AGENT_API_KEY=replace-me

# --- Shared -----------------------------------------------------------------
# Max seconds to wait for the agent before timing out.
AGENT_TIMEOUT_SECONDS=45
