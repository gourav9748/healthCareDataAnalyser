# ---------------------------------------------------------------------------
# AI agent configuration
# ---------------------------------------------------------------------------
# The URL of your agent hosted on Vercel (or anywhere). The /api/agent route
# on THIS server proxies to it — the browser never calls it directly, so the
# key below is never exposed to the client.
AGENT_ENDPOINT=https://your-agent.vercel.app/api/run

# Secret used to authenticate this server -> agent. Kept server-side only.
AGENT_API_KEY=replace-me

# Optional: max seconds to wait for the agent before timing out.
AGENT_TIMEOUT_SECONDS=45
