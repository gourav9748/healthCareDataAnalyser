# ---------------------------------------------------------------------------
# AI agent configuration
# ---------------------------------------------------------------------------
# The "Run analysis" button calls /api/agent, which resolves in this order:
#   1. External agent proxy (AGENT_ENDPOINT + AGENT_API_KEY), if set.
#   2. Built-in Gemini agent (GEMINI_API_KEY), if set.
#   3. Fallback: returns the prompt it would have sent (no key needed).

# --- Option A: built-in Gemini agent (recommended) -------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-2.5-flash. Other options: gemini-2.5-flash-lite,
# gemini-2.5-pro. Google retires models over time — GET /api/models on your
# deployment to see exactly which models your key can use, then set one here.
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: external agent proxy (optional override) --------------------
# If both are set, this takes precedence over Gemini. Leave unset to use Gemini.
# AGENT_ENDPOINT=https://your-agent.vercel.app/api/run
# AGENT_API_KEY=replace-me

# --- Shared -----------------------------------------------------------------
# Max seconds to wait for the agent before timing out.
AGENT_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Admin-controlled prompt templates (optional)
# ---------------------------------------------------------------------------
# The /admin page lets an admin edit the default prompt templates. Templates are
# stored in Vercel Edge Config; the app falls back to built-in defaults when
# this isn't configured, so it works without any of these set.

# Password to sign in at /admin.
ADMIN_PASSWORD=choose-a-strong-password

# Reading templates: added automatically when you connect a Global Config (a.k.a.
# Edge Config) store to the project in Vercel. Named GLOBAL_CONFIG in the current
# UI; EDGE_CONFIG is also accepted for older setups. It's the read connection string.
GLOBAL_CONFIG=
# EDGE_CONFIG=

# Writing templates (admin "Save") goes through the Vercel API and needs a token
# from https://vercel.com/account/tokens. The store id is auto-derived from the
# connection string above, so EDGE_CONFIG_ID is optional. VERCEL_TEAM_ID only if
# the project belongs to a team.
VERCEL_API_TOKEN=
# EDGE_CONFIG_ID=
# VERCEL_TEAM_ID=
